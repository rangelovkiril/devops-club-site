---
interface Props {
  variant: "full" | "compact";
  width: string;
}

const { variant, width } = Astro.props;

const name = variant === "full" ? "wordmark" : "wordmark-compact";
const height = variant === "full" ? 200 : 160;
---

<img
  src={`/brand/${name}-on-dark.svg`}
  alt="TUES DevOps"
  width="505"
  height={height}
  style={`width: ${width}`}
/>
