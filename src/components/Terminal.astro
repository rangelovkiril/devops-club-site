---
interface Props {
  command?: string;
  label?: string;
}

const { command, label } = Astro.props;
const hasAction = Astro.slots.has("action");
---

<div
  class:list={["term", { act: hasAction }]}
  role={label ? "group" : undefined}
  aria-label={label}
>
  <p class="cmd"><b>$</b> <slot name="command">{command}</slot></p>
  <slot />
  {hasAction && <div class="action"><slot name="action" /></div>}
</div>

<style>
  .term {
    border: 1.5px solid var(--line);
    border-radius: 8px;
    padding: 20px;
    font-size: 14px;
    line-height: 1.6;
  }

  .cmd {
    font-size: 16px;
    color: var(--muted);
    margin: 0 0 16px;
    overflow-wrap: anywhere;
  }

  .cmd b {
    color: var(--accent);
    font-weight: 500;
  }

  .act .action {
    margin-top: 20px;
  }

  @media (min-width: 900px) {
    .term {
      padding: 28px;
    }

    /* Команда и изход вляво, действието вдясно, центрирано по двата реда. */
    .act {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 24px;
      align-items: center;
    }

    .act > :global(*:not(.action)) {
      grid-column: 1;
    }

    .act .action {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0;
    }
  }
</style>
