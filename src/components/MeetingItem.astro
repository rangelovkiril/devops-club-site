---
import type { CollectionEntry } from "astro:content";

interface Props {
  meeting: CollectionEntry<"meetings">;
  roomLabel: string;
  materialsLabel: string;
}

const { meeting, roomLabel, materialsLabel } = Astro.props;
const { date, time, title, topic, speaker, room, materials } = meeting.data;

const dateText = new Intl.DateTimeFormat("bg-BG", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(date);
const when = [dateText, time, room && `${roomLabel} ${room}`].filter(Boolean);
---

<li class="item">
  <h3>{title}</h3>
  <p class="meta">
    <time datetime={date.toISOString().slice(0, 10)}>{when[0]}</time>
    {when.slice(1).map((part) => <span> · {part}</span>)}
  </p>
  <p>{topic}</p>
  <p class="speaker">{speaker}</p>
  {
    materials && (
      <a href={materials} aria-label={`${materialsLabel}: ${title}`}>
        {materialsLabel}
      </a>
    )
  }
</li>

<style>
  .item {
    max-width: var(--card-max, var(--measure));
    margin-bottom: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    list-style: none;
  }

  .item :global(p) {
    margin-bottom: var(--space-1);
  }

  .meta,
  .speaker {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  h3 {
    margin-bottom: var(--space-1);
  }
</style>
