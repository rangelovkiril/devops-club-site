---
interface Props {
  contactLabel: string;
  email: string;
  links: { label: string; href: string }[];
}

const { contactLabel, email, links } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <img
      class="logo"
      src="/brand/wordmark-compact-on-dark.svg"
      alt="TUES DevOps"
      width="505"
      height="160"
    />
    <p>{contactLabel}: <a href={`mailto:${email}`}>{email}</a></p>
    <ul class="links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .logo {
    width: 9rem;
    margin-bottom: var(--space-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
