---
import Logo from "./Logo.astro";

interface Props {
  contactLabel: string;
  email: string;
  links: { label: string; href: string }[];
}

const { contactLabel, email, links } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="logo"><Logo variant="compact" width="9rem" /></div>
    <p>{contactLabel}: <a class="email" href={`mailto:${email}`}>{email}</a></p>
    <ul class="links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .logo {
    margin-bottom: var(--space-3);
  }

  /* Без преноса на тирето домейнът се чете като elsys-/bg.org. */
  .email {
    white-space: nowrap;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
