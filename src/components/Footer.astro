---
import Logo from "./Logo.astro";

interface Props {
  tagline: string;
  email: string;
  contact: string;
  discord: { label: string; href: string };
  links: { key: "source" | "network"; label: string; href: string }[];
  gap: number;
}

const { tagline, email, contact, discord, links, gap } = Astro.props;

// Пренос само след @: адресът не се къса насред домейна или името,
// включително по тирето в elsys-bg.org.
const [local, domain] = email.split("@");
const svg = {
  width: 20,
  height: 20,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": 2,
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
};

// Прости монохромни знаци, без иконков пакет (N1). Discord е опростен балон.
const icons = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
  discord:
    '<path d="M5 5h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-4 3v-3H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"></path><circle cx="9" cy="11" r="1" fill="currentColor"></circle><circle cx="15" cy="11" r="1" fill="currentColor"></circle>',
  source: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5"></path>',
  network:
    '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"></path>',
};
---

<footer class="f" style={`margin-top: ${gap}px`}>
  <div class="w fg">
    <div class="fl">
      <Logo />
      <p>{tagline}</p>
    </div>
    <ul class="fd">
      <li>
        <svg {...svg} set:html={icons.mail} />
        <span>
          <span class="nb">{contact} ·</span>{" "}
          <a class="mail" href={`mailto:${email}`}><span class="nb">{local}@</span><wbr /><span class="nb">{domain}</span></a>
        </span>
      </li>
      <li>
        <svg {...svg} set:html={icons.discord} />
        <a href={discord.href}>{discord.label}</a>
      </li>
      {
        links.map((link) => (
          <li>
            <svg {...svg} set:html={icons[link.key]} />
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="exit"><span>~/devops $</span> exit 0</p>
  </div>
</footer>

<style>
  .f {
    border-top: 1px solid var(--line);
  }

  .fg {
    display: grid;
    gap: 32px;
    padding-top: 48px;
    padding-bottom: max(32px, env(safe-area-inset-bottom));
  }

  .fl p {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 34ch;
  }

  .fd {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
  }

  .fd li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
  }

  .fd svg {
    flex: none;
    margin-top: 2px;
    color: var(--muted);
  }

  .nb {
    white-space: nowrap;
  }

  /* Под 900 px ширината за адреса е 193–248 px: по-малък размер, за да се събере частта преди @. */
  .mail {
    font-size: 14px;
  }

  .exit {
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 16px;
    color: var(--muted);
  }

  .exit span {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .mail {
      font-size: inherit;
    }

    .fg {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 48px;
      row-gap: 40px;
      padding-top: 64px;
    }

    .exit {
      grid-column: 1 / -1;
    }
  }
</style>
