---
import { getCollection } from "astro:content";
import MeetingItem from "./MeetingItem.astro";
import Section from "./Section.astro";

interface Props {
  meetings: {
    heading: string;
    paragraphs: string[];
    upcomingHeading: string;
    emptyTitle: string;
    emptyText: string;
    roomLabel: string;
    materialsLabel: string;
  };
  pastHeading: string;
}

const { meetings: text, pastHeading } = Astro.props;

const all = await getCollection("meetings");
const planned = all
  .filter((m) => m.data.status === "planned")
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const past = all
  .filter((m) => m.data.status === "past")
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const labels = {
  roomLabel: text.roomLabel,
  materialsLabel: text.materialsLabel,
};
---

<header class="page-head">
  <div class="container">
    <h1>{text.heading}</h1>
    {text.paragraphs.map((p) => <p>{p}</p>)}
  </div>
</header>

<Section id="upcoming" heading={text.upcomingHeading}>
  {
    planned.length > 0 ? (
      <ul class="list">
        {planned.map((meeting) => <MeetingItem meeting={meeting} {...labels} />)}
      </ul>
    ) : (
      <div class="soon">
        <h3>{text.emptyTitle}</h3>
        <p>{text.emptyText}</p>
      </div>
    )
  }
</Section>

{
  past.length > 0 && (
    <Section id="past" heading={pastHeading}>
      <ul class="list">
        {past.map((meeting) => <MeetingItem meeting={meeting} {...labels} />)}
      </ul>
    </Section>
  )
}

<style>
  .page-head {
    padding: var(--space-4) 0;
  }

  .list {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Две колони над 900 px: картите се опъват, текстът в тях остава тесен. */
  @media (min-width: 56.25rem) {
    .list {
      --card-max: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }

    .list :global(.item) {
      margin-bottom: 0;
    }
  }

  .soon {
    max-width: var(--measure);
    padding: var(--space-2) var(--space-3);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: 0.5rem;
  }

  .soon p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
