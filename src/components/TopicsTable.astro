---
import { type Meeting, meetingHref } from "../lib/meetings";

interface Props {
  note: string;
  command: string;
  columns: string[];
  none: string;
  topics: { id: string; name: string; tools: string[] }[];
  meetings: Meeting[];
}

const { note, command, columns, none, topics, meetings } = Astro.props;
---

<p class="note">{note}</p>
<div class="tbl">
  <p class="cmd"><b>$</b> {command}</p>
  <div class="tr head">{columns.map((column) => <span>{column}</span>)}</div>
  {
    topics.map((topic) => {
      const lectures = meetings.filter((m) => m.data.area === topic.id);
      return (
        <div class="tr">
          <span class="n">{topic.name}</span>
          <div class="tech">
            {topic.tools.map((tool) => <span>{tool}</span>)}
          </div>
          <span class="lec">
            {lectures.length > 0
              ? lectures.map((m) => (
                  <a href={meetingHref(m)}>{m.data.title}</a>
                ))
              : none}
          </span>
        </div>
      );
    })
  }
</div>

<style>
  .note {
    color: var(--muted);
    margin: 0 0 20px;
    max-width: 62ch;
  }

  .tbl {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 4px 20px;
    font-size: 15px;
  }

  .cmd {
    color: var(--muted);
    margin: 0;
    padding: 14px 0;
    font-size: 16px;
    overflow-wrap: anywhere;
  }

  .cmd b {
    color: var(--accent);
    font-weight: 500;
  }

  .tr {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  .tr.head {
    display: none;
  }

  .n {
    font-weight: 700;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 14px;
    color: var(--muted);
  }

  .lec {
    font-size: 14px;
    color: var(--muted);
  }

  .lec a {
    display: block;
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .tbl {
      padding: 4px 28px;
    }

    .tr {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 24px;
      align-items: center;
    }

    .tr.head {
      display: grid;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      padding: 12px 0;
    }
  }
</style>
