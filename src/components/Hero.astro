---
import DiscordButton from "./DiscordButton.astro";

interface Props {
  title: string;
  lead: string;
  cta: string;
  hint: string;
  discordUrl: string;
}

const { title, lead, cta, hint, discordUrl } = Astro.props;
---

<header class="hero">
  <div class="container">
    <img
      class="logo"
      src="/brand/wordmark-on-dark.svg"
      alt="TUES DevOps"
      width="505"
      height="200"
    />
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <DiscordButton href={discordUrl} label={cta} />
    <p class="hint">{hint}</p>
  </div>
</header>

<style>
  .hero {
    padding: var(--space-4) 0 var(--space-5);
  }

  .logo {
    width: 14rem;
    margin-bottom: var(--space-3);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .hint {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
