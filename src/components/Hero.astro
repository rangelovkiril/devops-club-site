---
import Button from "./Button.astro";

interface Props {
  prompt: string;
  title: string;
  lead: string;
  cta: string;
  hint: string;
  discordUrl: string;
}

const { prompt, title, lead, cta, hint, discordUrl } = Astro.props;
---

<section class="w hero">
  <div>
    <p class="prompt">{prompt}</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <Button href={discordUrl} label={cta} />
    <p class="hint">{hint}</p>
  </div>
  <slot />
</section>

<style>
  .hero {
    display: grid;
    gap: 40px;
    padding-top: 40px;
    padding-bottom: 64px;
  }

  .lead {
    font-size: 18px;
    line-height: 1.6;
    max-width: 40ch;
    margin: 0 0 32px;
  }

  .hint {
    font-size: 14px;
    color: var(--muted);
    margin: 14px 0 0;
  }

  .hero > :global(.term) {
    align-self: start;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 64px;
      padding-top: 112px;
      padding-bottom: 112px;
      align-items: center;
    }

    .lead {
      font-size: 21px;
    }
  }
</style>
