---
import DiscordButton from "./DiscordButton.astro";

interface Props {
  title: string;
  lead: string;
  cta: string;
  hint: string;
  discordUrl: string;
}

const { title, lead, cta, hint, discordUrl } = Astro.props;
---

<header class="hero">
  <div class="container">
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <DiscordButton href={discordUrl} label={cta} />
    <p class="hint">{hint}</p>
  </div>
</header>

<style>
  .hero {
    padding: var(--space-4) 0 var(--space-5);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .hint {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 64rem) {
    .hero {
      padding: var(--space-5) 0 6rem;
    }

    .lead {
      font-size: 1.25rem;
    }
  }
</style>
