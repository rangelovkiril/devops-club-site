---
import Button from "./Button.astro";

interface Props {
  prompt: string;
  title: string;
  quote: string;
  cta: string;
  more: { label: string; href: string };
  discordUrl: string;
}

const { prompt, title, quote, cta, more, discordUrl } = Astro.props;
---

<section class="w hero">
  <div class="intro">
    <p class="prompt">{prompt}</p>
    <h1>{title}</h1>
    <p class="quote">{quote}</p>
    <div class="actions">
      <Button href={discordUrl} label={cta} large />
      <a class="more" href={more.href}><span class="lbl">{more.label}</span><span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
  <slot />
</section>

<style>
  .hero {
    display: grid;
    gap: 40px;
    padding-top: 40px;
    padding-bottom: 64px;
  }

  .quote {
    font-size: 18px;
    line-height: 1.6;
    max-width: 40ch;
    margin: 0 0 32px;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 28px;
  }

  .actions > :global(.btn) {
    flex: none;
  }

  /* Без рамка и фон, но по-едър от бутона (17/18 px): да не изчезва до него. */
  .more {
    display: inline-flex;
    align-items: center;
    gap: 1ch;
    min-height: 56px;
    font-size: 19px;
    font-weight: 700;
    text-decoration: none;
  }

  .lbl {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /*
   * От 900 px горният ръб на конзолата е върхът на главните букви на
   * заглавието (подканата остава над него), а долният ръб на бутоните е
   * долният ръб на конзолата. .intro се разгръща в мрежата на hero-а:
   * заглавието и конзолата започват от един ред, а редът на цитата поема
   * излишната височина. Конзолата не се разтяга: ако е по-ниска от лявата
   * колона, долните ръбове не съвпадат, но нищо не се чупи.
   */
  @media (min-width: 900px) {
    .hero {
      --h1-size: 80px;
      --h1-lh: 1.02;

      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: auto auto 1fr auto;
      column-gap: 64px;
      row-gap: 0;
      padding-top: 112px;
      padding-bottom: 112px;
      align-items: start;
    }

    .intro {
      display: contents;
    }

    /* Без leading над първия ред: кутията започва от върха на главните. */
    .hero .prompt {
      --lh: 1.6;
      grid-column: 1;
      grid-row: 1;
      line-height: var(--lh);
      margin-top: calc((var(--lh) - 1.32) / 2 * -1em - 0.286em);
    }

    @supports (text-box: trim-start cap alphabetic) {
      .hero .prompt {
        margin-top: 0;
        text-box: trim-start cap alphabetic;
      }
    }

    .hero h1 {
      grid-column: 1;
      grid-row: 2;
      font-size: var(--h1-size);
      line-height: var(--h1-lh);
    }

    /*
     * Надолу от върха на реда на заглавието до върха на главните:
     * half-leading (lh - 1.32) / 2 плюс 1.02 - 0.734 = 0.286 (метриките на
     * JetBrains Mono, виж DECISIONS.md).
     */
    .hero > :global(.term) {
      grid-column: 2;
      grid-row: 2 / 5;
      margin-top: calc(((var(--h1-lh) - 1.32) / 2 + 0.286) * var(--h1-size));
    }

    .quote {
      grid-column: 1;
      grid-row: 3;
      font-size: 21px;
      margin-bottom: 40px;
    }

    .actions {
      grid-column: 1;
      grid-row: 4;
    }

    .more {
      font-size: 20px;
    }
  }
</style>
