---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="button" href={href}>{label}</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0.5rem var(--space-3);
    border-radius: 0.5rem;
    background: var(--action);
    color: var(--on-action);
    font-weight: 700;
    text-decoration: none;
  }

  .button:hover {
    background: var(--action-hover);
    color: var(--on-action);
  }
</style>
