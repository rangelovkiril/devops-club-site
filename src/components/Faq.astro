---
import Chevron from "./Chevron.astro";

interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="q">
        <summary>
          {item.question}
          <Chevron />
        </summary>
        <p>{item.answer}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
    max-width: 62ch;
  }

  .q {
    border-bottom: 1px solid var(--line);
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 12px 0;
    font-weight: 700;
    line-height: 1.35;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  p {
    margin: 0;
    padding: 0 0 18px;
    color: var(--muted);
  }
</style>
