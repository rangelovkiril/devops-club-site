---
import DiscordButton from "./DiscordButton.astro";

interface Props {
  heading: string;
  text: string;
  cta: string;
  discordUrl: string;
}

const { heading, text, cta, discordUrl } = Astro.props;
---

<section class="join" aria-labelledby="join-heading">
  <div class="container">
    <h2 id="join-heading">{heading}</h2>
    <p>{text}</p>
    <DiscordButton href={discordUrl} label={cta} />
  </div>
</section>

<style>
  .join {
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border);
  }
</style>
