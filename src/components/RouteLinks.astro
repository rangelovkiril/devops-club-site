---
interface Props {
  label: string;
  items: { cmd: string; href: string; title: string; text: string }[];
  discord: { cmd: string; title: string; text: string; href: string };
}

const { label, items, discord } = Astro.props;
---

<nav class="w" aria-label={label}>
  <div class="routes">
    {
      items.map((item) => (
        <a class="rt" href={item.href}>
          <span class="path">{item.cmd}</span>
          <span class="ttl">{item.title}</span>
          <span class="ds">{item.text}</span>
        </a>
      ))
    }
    <a class="rt ext" href={discord.href}>
      <span class="path">{discord.cmd}</span>
      <span class="ttl">{discord.title}</span>
      <span class="ds">{discord.text}</span>
    </a>
  </div>
</nav>

<style>
  .routes {
    border-top: 1px solid var(--line);
  }

  .rt {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--fg);
  }

  .rt .path {
    font-size: 18px;
    color: var(--accent);
  }

  .rt .ttl {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 10px;
    text-decoration-skip-ink: auto;
    text-decoration-color: var(--blue);
  }

  .rt.ext .ttl {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .rt .ds {
    font-size: 18px;
    color: var(--muted);
    max-width: 52ch;
  }

  @media (min-width: 900px) {
    .rt {
      grid-template-columns: 180px 260px minmax(0, 1fr);
      align-items: center;
      gap: 32px;
      padding: 36px 0;
    }

    .rt .ttl {
      font-size: 44px;
      text-underline-offset: 6px;
    }

    .rt .ds {
      font-size: 20px;
    }
  }
</style>
