---
interface Props {
  prompt: string;
  title: string;
  lead?: string;
  note?: string;
  tight?: boolean;
}

const { prompt, title, lead, note, tight } = Astro.props;
---

<section class:list={["w", "ph", { tight }]}>
  <p class="prompt">{prompt}</p>
  <h1>{title}</h1>
  {
    lead && (
      <p class="lead">
        {lead}{" "}
        {note && <span>{note}</span>}
      </p>
    )
  }
  <slot />
</section>

<style>
  .ph {
    padding-top: 40px;
    padding-bottom: 48px;
  }

  .ph.tight {
    padding-bottom: 40px;
  }

  .lead {
    font-size: 18px;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0;
  }

  .lead span {
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .ph {
      padding-top: 96px;
      padding-bottom: 72px;
    }

    .ph.tight {
      padding-bottom: 64px;
    }

    .lead {
      font-size: 20px;
    }
  }
</style>
