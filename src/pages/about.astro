---
import AnchorSection from "../components/AnchorSection.astro";
import Faq from "../components/Faq.astro";
import PageHead from "../components/PageHead.astro";
import Layout from "../layouts/Layout.astro";
import { getAbout, getHome } from "../lib/content";

const about = await getAbout();
const { discordUrl } = await getHome();
const sections = ["whatis", "does", "speakers", "faq"];
---

<Layout title={about.title} description={about.description} footerGap={24}>
  <PageHead
    prompt={about.prompt}
    title={about.title}
    lead={about.lead}
    tight
  >
    <nav class="toc" aria-label={about.tocLabel}>
      {sections.map((id) => <a href={`#${id}`}>#{id}</a>)}
    </nav>
  </PageHead>

  <AnchorSection id="whatis" title={about.whatis.heading}>
    <div class="b">
      {about.whatis.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </AnchorSection>

  <AnchorSection id="does" title={about.does.heading}>
    <div class="b">
      {about.does.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </AnchorSection>

  <AnchorSection id="speakers" title={about.speakers.heading}>
    <div class="b">
      <p>{about.speakers.text} <a href={discordUrl}>{about.speakers.cta}</a></p>
    </div>
  </AnchorSection>

  <AnchorSection id="faq" title={about.faq.heading}>
    <Faq items={about.faq.items} />
  </AnchorSection>
</Layout>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    margin-top: 24px;
    font-size: 15px;
  }

  .toc a {
    padding: 10px 0;
  }

  .b p {
    color: var(--muted);
    margin: 0 0 14px;
    max-width: 62ch;
  }

  .b p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 900px) {
    .b p {
      font-size: 17px;
    }
  }
</style>
