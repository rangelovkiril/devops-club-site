---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";

const home = await getEntry("home", "home");
if (!home) throw new Error("src/content/home.md is missing");
const { description, notFound } = home.data;
---

<Layout title={notFound.title} description={description}>
  <main id="main" class="container">
    <img
      class="logo"
      src="/brand/wordmark-compact-on-dark.svg"
      alt="TUES DevOps"
      width="505"
      height="160"
    />
    <h1>{notFound.title}</h1>
    <p>{notFound.text}</p>
    <p><a href="/">{notFound.back}</a></p>
  </main>
</Layout>

<style>
  main {
    padding: var(--space-5) 0;
  }

  .logo {
    width: 9rem;
    margin-bottom: var(--space-3);
  }
</style>
