---
import Button from "../components/Button.astro";
import Terminal from "../components/Terminal.astro";
import Layout from "../layouts/Layout.astro";
import { getHome } from "../lib/content";

const { notFound, nav } = await getHome();
const others = nav.links.filter((link) => link.href !== "/");
---

<Layout
  title={notFound.title}
  description={notFound.description}
  footerGap={72}
>
  <div class="w nf">
    <p class="prompt">~/devops $</p>
    <h1>{notFound.title}</h1>
    <p class="lead">{notFound.text}</p>
    <!-- Терминалът е част от шаблона, не от съдържанието. -->
    <Terminal command="kubectl describe pod devops-elsys-club">
      <dl>
        <dt>Name:</dt><dd>devops-elsys-club</dd>
        <dt>Image:</dt><dd>devops.elsys.club/<span id="pn">page</span>:latest</dd>
        <dt>Ready:</dt><dd>0/1</dd>
        <dt>Status:</dt><dd class="bad">ErrImagePull</dd>
        <dt>Restarts:</dt><dd>0</dd>
        <dt>Age:</dt><dd>404s</dd>
      </dl>
      <p class="evt">
        Events:<span>Back-off pulling image "devops.elsys.club/<span id="pn2">page</span>:latest"</span>
      </p>
    </Terminal>
    <div class="go">
      <Button href="/" label={notFound.back} />
      <div class="alt">
        {others.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>
  </div>
  <!-- Единственият JS на сайта (N2): без него в блока остава "page". -->
  <script is:inline>
    var slug = location.pathname.replace(/[^\w-]/g, "").slice(0, 40);
    if (slug) {
      document.getElementById("pn").textContent = slug;
      document.getElementById("pn2").textContent = slug;
    }
  </script>
</Layout>

<style>
  .nf {
    padding-top: 40px;
  }

  h1 {
    font-size: 40px;
    line-height: 1.05;
    margin: 0 0 16px;
  }

  .lead {
    font-size: 17px;
    margin: 0 0 28px;
    max-width: 40ch;
  }

  .nf > :global(.term) {
    max-width: 720px;
  }

  dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 2px 16px;
    margin: 0;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  dd.bad {
    color: var(--accent);
    font-weight: 700;
  }

  .evt {
    margin: 10px 0 0;
    color: var(--muted);
  }

  .evt > span {
    display: block;
    color: var(--fg);
    padding-left: 2ch;
    overflow-wrap: anywhere;
  }

  .go {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 32px;
  }

  .alt {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    font-size: 16px;
  }

  .alt a {
    padding: 10px 0;
  }

  @media (min-width: 900px) {
    .nf {
      padding-top: 96px;
    }

    h1 {
      font-size: 72px;
    }

    .go {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
  }
</style>
