---
import EventsTable from "../components/EventsTable.astro";
import Hero from "../components/Hero.astro";
import RouteLinks from "../components/RouteLinks.astro";
import Layout from "../layouts/Layout.astro";
import { getHome } from "../lib/content";
import { formatDate, getMeetings } from "../lib/meetings";

const { title, discordUrl, hero, events, routes } = await getHome();

const { planned, past } = await getMeetings();
const [next] = planned;
const href = (id: string) => `/meetings#${id}`;
const rows = [
  next
    ? {
        when: formatDate(next.data.date),
        status: events.pending,
        text: next.data.title,
        href: href(next.id),
      }
    : { when: events.soon, status: events.pending, text: events.pendingText },
  ...past.slice(0, 2).map((meeting) => ({
    when: formatDate(meeting.data.date),
    status: events.completed,
    text: meeting.data.title,
    href: href(meeting.id),
    done: true,
  })),
];
---

<Layout>
  <Hero
    prompt={hero.prompt}
    title={title}
    lead={hero.lead}
    cta={hero.cta}
    hint={hero.hint}
    discordUrl={discordUrl}
  >
    <EventsTable
      label={events.label}
      command={events.command}
      columns={events.columns}
      rows={rows}
    />
  </Hero>
  <RouteLinks label={routes.label} items={routes.items} />
</Layout>
